+describe('SettingsRoot desktop open event', () => {
+  it('opens the panel when a desktop shell dispatches dsh:open-settings on window', () => {
+    mount()
+    act(() => {
+      window.dispatchEvent(new Event('dsh:open-settings'))
+    })
+    expect(screen.getByRole('dialog')).toBeTruthy()
+    expect(screen.getByRole('button', { name: 'Settings', expanded: true })).toBeTruthy()
+  })
+
+  it('removes the window listener when the trigger unmounts', () => {
+    const removeSpy = vi.spyOn(window, 'removeEventListener')
+    const { view } = mount()
+    view.unmount()
+    expect(removeSpy.mock.calls.some(([name]) => name === 'dsh:open-settings')).toBe(true)
+    removeSpy.mockRestore()
+  })
+})
