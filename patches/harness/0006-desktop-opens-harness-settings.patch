+  // Desktop shells have no URL route into this surface: the native menu bar
+  // dispatches `dsh:open-settings` on window, and the trigger stays mounted
+  // (rail or wide), so the listener lives for the panel's whole lifetime.
+  useEffect(() => {
+    const openFromDesktop = (): void => { setOpen(true) }
+    window.addEventListener('dsh:open-settings', openFromDesktop)
+    return () => { window.removeEventListener('dsh:open-settings', openFromDesktop) }
+  }, [])
